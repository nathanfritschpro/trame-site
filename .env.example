# ============ TRAME — Variables d'environnement (modèle) ============
# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local ne doit JAMAIS être commité (voir .gitignore).

# Endpoint Formspree pour le formulaire de contact.
# Créer un formulaire sur https://formspree.io (gratuit jusqu'à 50 soumissions/mois)
# puis coller l'URL ci-dessous. Elle ressemble à : https://formspree.io/f/xyzabcde
FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORMSPREE_ID
